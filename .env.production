# Base URL of the background scrobbling worker.
#
# Not a secret — it is a public API origin and is baked into the bundle. It
# lives here rather than in CI so the value is reviewable in the repo.
#
# Setting this does not switch the feature on by itself: the client asks the
# worker for capacity on load and stays silent unless it answers. An
# unreachable or undeployed worker therefore degrades to the old behaviour
# rather than offering a handoff that cannot complete.
VUE_APP_BACKGROUND_API=https://api.savas.ca
